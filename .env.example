# Optional Etherscan V2 key (same key works for supported chains)
ETHERSCAN_API_KEY=
# Network-specific aliases are also accepted, e.g. BSCSCAN_API_KEY, BASESCAN_API_KEY
# Optional RPC URLs (or pass --rpc on the command line)
BSC_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
